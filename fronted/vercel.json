{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "zeroConfig": true
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://your-todo-backend-deployment-url.up.railway.app/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://your-todo-backend-deployment-url.up.railway.app"
  }
}